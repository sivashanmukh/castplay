{
  "name": "castplay",
  "version": "0.1.0",
  "description": "A 12 KB dependency-free player for asciicast v2 terminal recordings, for pages where asciinema-player cannot run: no WebAssembly, no CDN stylesheet, no fetch.",
  "main": "castplay.js",
  "types": "castplay.d.ts",
  "style": "castplay.css",
  "unpkg": "castplay.js",
  "jsdelivr": "castplay.js",
  "exports": {
    ".": { "types": "./castplay.d.ts", "default": "./castplay.js" },
    "./castplay.css": "./castplay.css",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["castplay.js", "castplay.css", "castplay.d.ts", "llms.txt"],
  "scripts": { "test": "node test.js" },
  "keywords": [
    "asciicast", "asciinema", "asciinema-player", "terminal", "terminal-player",
    "terminal-recording", "player", "ansi", "ansi-to-html", "vt100", "csp",
    "no-dependencies", "zero-dependencies", "single-file", "offline", "embed",
    "demo", "screencast"
  ],
  "homepage": "https://sivashanmukh.github.io/castplay/demo/",
  "repository": { "type": "git", "url": "git+https://github.com/sivashanmukh/castplay.git" },
  "bugs": { "url": "https://github.com/sivashanmukh/castplay/issues" },
  "author": "Siva Shanmukh Vetcha",
  "license": "MIT"
}
